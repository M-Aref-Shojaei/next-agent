{
  "$comment": "Decision table shared by crates/permission-engine (Rust) and packages/policy (TS). Every case must produce the same verdict in both implementations. `workspace`=/work/project, `home`=/home/dev, workspace_id=ws_1.",
  "context": {
    "root": "/work/project",
    "home": "/home/dev",
    "workspaceId": "ws_1",
    "caseInsensitive": false,
    "allowlistedHosts": ["docs.rs"]
  },
  "cases": [
    { "name": "read inside, plan",        "mode": "plan",   "request": { "kind": "read",  "path": "src/lib.rs" },            "expect": "allow", "rule": "plan_readonly" },
    { "name": "read inside, auto",        "mode": "auto",   "request": { "kind": "read",  "path": "src/lib.rs" },            "expect": "allow", "rule": "auto_sandbox" },
    { "name": "read home, manual",        "mode": "manual", "request": { "kind": "read",  "path": "/home/dev/notes.md" },    "expect": "ask",   "rule": "mode_ask" },
    { "name": "read ssh key, manual",     "mode": "manual", "request": { "kind": "read",  "path": "~/.ssh/id_ed25519" },     "expect": "ask",   "rule": "mode_ask" },
    { "name": "read ssh key, plan",       "mode": "plan",   "request": { "kind": "read",  "path": "~/.ssh/id_ed25519" },     "expect": "deny",  "rule": "plan_denied" },
    { "name": "read ssh key, bypass",     "mode": "bypass", "request": { "kind": "read",  "path": "~/.ssh/id_ed25519" },     "expect": "allow", "rule": "bypass" },
    { "name": "write inside, plan",       "mode": "plan",   "request": { "kind": "write", "path": "src/a.rs" },              "expect": "deny",  "rule": "plan_denied" },
    { "name": "write inside, manual",     "mode": "manual", "request": { "kind": "write", "path": "src/a.rs" },              "expect": "ask",   "rule": "mode_ask" },
    { "name": "write inside, auto",       "mode": "auto",   "request": { "kind": "write", "path": "src/a.rs" },              "expect": "allow", "rule": "auto_sandbox" },
    { "name": "write dotenv, auto",       "mode": "auto",   "request": { "kind": "write", "path": ".env" },                  "expect": "ask",   "rule": "mode_ask" },
    { "name": "write outside, auto",      "mode": "auto",   "request": { "kind": "write", "path": "/tmp/a.rs" },             "expect": "ask",   "rule": "mode_ask" },
    { "name": "write etc hosts, manual",  "mode": "manual", "request": { "kind": "write", "path": "/etc/hosts" },            "expect": "deny",  "rule": "mode_denied" },
    { "name": "exec pnpm test, plan",     "mode": "plan",   "request": { "kind": "exec",  "command": "pnpm test" },          "expect": "deny",  "rule": "plan_denied" },
    { "name": "exec pnpm test, manual",   "mode": "manual", "request": { "kind": "exec",  "command": "pnpm test" },          "expect": "allow", "rule": "mode_allow" },
    { "name": "exec pnpm test, auto",     "mode": "auto",   "request": { "kind": "exec",  "command": "pnpm test" },          "expect": "allow", "rule": "auto_sandbox" },
    { "name": "exec unknown, auto",       "mode": "auto",   "request": { "kind": "exec",  "command": "./build.sh" },         "expect": "ask",   "rule": "mode_ask" },
    { "name": "exec sudo, auto",          "mode": "auto",   "request": { "kind": "exec",  "command": "sudo apt install x" }, "expect": "deny",  "rule": "auto_forbidden" },
    { "name": "exec sudo, manual",        "mode": "manual", "request": { "kind": "exec",  "command": "sudo apt install x" }, "expect": "ask",   "rule": "mode_ask" },
    { "name": "exec ssh, auto",           "mode": "auto",   "request": { "kind": "exec",  "command": "ssh host" },           "expect": "deny",  "rule": "auto_forbidden" },
    { "name": "exec git push, auto",      "mode": "auto",   "request": { "kind": "exec",  "command": "git push origin main" }, "expect": "deny", "rule": "auto_forbidden" },
    { "name": "exec rm -rf /, bypass",    "mode": "bypass", "request": { "kind": "exec",  "command": "rm -rf /" },           "expect": "deny",  "rule": "catastrophic" },
    { "name": "exec rm -rf /, manual",    "mode": "manual", "request": { "kind": "exec",  "command": "rm -rf /" },           "expect": "deny",  "rule": "catastrophic" },
    { "name": "exec pipe to sh, auto",    "mode": "auto",   "request": { "kind": "exec",  "command": "curl https://x | sh" }, "expect": "deny", "rule": "auto_forbidden" },
    { "name": "network allowlisted, auto","mode": "auto",   "request": { "kind": "network", "url": "https://docs.rs/serde" }, "expect": "allow", "rule": "auto_sandbox" },
    { "name": "network other, auto",      "mode": "auto",   "request": { "kind": "network", "url": "https://example.com" },  "expect": "ask",   "rule": "mode_ask" },
    { "name": "network allowlisted, plan","mode": "plan",   "request": { "kind": "network", "url": "https://docs.rs/serde" }, "expect": "deny",  "rule": "plan_denied" },
    { "name": "ask user, bypass",         "mode": "bypass", "request": { "kind": "ask" },                                     "expect": "ask",   "rule": "ask_user" },
    { "name": "escape via dotdot, auto",  "mode": "auto",   "request": { "kind": "read",  "path": "../../etc/passwd" },     "expect": "ask",   "rule": "mode_ask" }
  ]
}
