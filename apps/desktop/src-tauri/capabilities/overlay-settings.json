{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay-settings",
  "description": "Overlay window coucou-settings: core IPC and the overlay commands its page (apps/desktop/coucou/src/hub/main.ts) calls. None of Next Agent's. Generated by scripts/gen-capabilities.mjs.",
  "windows": [
    "coucou-settings"
  ],
  "permissions": [
    "core:default",
    "allow-boot",
    "allow-custom-sound",
    "allow-custom-sounds",
    "allow-flow-clear",
    "allow-flow-copy",
    "allow-flow-delete",
    "allow-flow-history",
    "allow-flow-models-download",
    "allow-flow-models-remove",
    "allow-flow-paste-again",
    "allow-flow-set-prefs",
    "allow-flow-set-snippets",
    "allow-flow-set-words",
    "allow-flow-snippets",
    "allow-flow-stats",
    "allow-flow-status",
    "allow-flow-words",
    "allow-hub-shown",
    "allow-mail-journal-clear",
    "allow-mail-triage",
    "allow-mail-triage-set",
    "allow-mail-undo",
    "allow-notes-delete",
    "allow-notes-export",
    "allow-notes-markdown",
    "allow-notes-rename",
    "allow-notes-rename-speaker",
    "allow-notes-retry",
    "allow-notes-start",
    "allow-notes-state",
    "allow-notes-stop",
    "allow-notes-summarize",
    "allow-notes-toggle-todo",
    "allow-open-settings-window"
  ]
}
