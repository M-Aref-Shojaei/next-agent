{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Next Agent",
  "version": "0.1.0",
  "identifier": "dev.nextagent.desktop",
  "build": {
    "beforeDevCommand": "cargo build --release -p coucou-hook && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cargo build --release -p coucou-hook && pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Next Agent",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; frame-src 'self' http://127.0.0.1:*; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
